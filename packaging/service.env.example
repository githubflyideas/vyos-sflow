# systemd EnvironmentFile syntax, NOT a shell script. Never source this file.
VYOS_SFLOW_ADDR=0.0.0.0:8066
VYOS_SFLOW_LISTEN=0.0.0.0:6343
VYOS_SFLOW_DATA=/config/vyos-sflow/data
# Explicit sFlow header identity; empty agent fails closed (health/login still work).
# Fixed rolling 48-hour flow/rollup retention. Existing data needs explicit migration.
# VYOS_SFLOW_ACCEPT_48H_RETENTION=true is consent to remove history older than 48h,
# NOT consent to clear unbound legacy history or change its agent identity.
VYOS_SFLOW_MEMORY_FRACTION=0.05
VYOS_SFLOW_DB_THREADS=1
# First login requires changing the default password; existing accounts are retained.
# Do not persist an initial plaintext VYOS_SFLOW_PASSWORD here.
