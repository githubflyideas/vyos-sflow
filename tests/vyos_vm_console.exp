#!/usr/bin/expect -f
# Private PTY bridge. Only base64 protocol frames go to the controlling process;
# no console output, command text, Tcl error detail or spawn banner is logged.
package require Expect
log_user 0
exp_internal 0
fconfigure stdout -buffering line -translation lf
fconfigure stdin -buffering line -translation lf
proc b64 {s} { binary encode base64 -maxlen 0 [encoding convertto utf-8 $s] }
proc reply {status before matched} { puts "R\t$status\t[b64 $before]\t[b64 $matched]"; flush stdout }
set child_pid 0
proc shutdown {} {
    global child_pid spawn_id
    if {$child_pid > 0} { catch {exec kill -TERM -- $child_pid} }
    catch {close -i $spawn_id}
    catch {wait -i $spawn_id}
    exit 0
}
trap shutdown {SIGTERM SIGINT SIGHUP}
proc bridge {} {
    global argv spawn_id child_pid timeout expect_out
    if {[llength $argv] < 1} { error "missing program" }
    spawn -noecho {*}$argv
    set child_pid [exp_pid -i $spawn_id]
    puts "PID\t$child_pid"
    match_max -i $spawn_id 1048576
    while {[gets stdin line] >= 0} {
        set fields [split $line "\t"]
        if {[llength $fields] != 3} { error "invalid frame" }
        lassign $fields op seconds encoded
        set text [encoding convertfrom utf-8 [binary decode base64 $encoded]]
        switch -- $op {
            send {
                send -i $spawn_id -- "$text\r"
                reply OK {} {}
            }
            expect {
                if {![string is integer -strict $seconds] || $seconds < 1} { error "invalid deadline" }
                set timeout $seconds
                unset -nocomplain expect_out
                expect {
                    -i $spawn_id
                    -indices -re $text {
                        set matched $expect_out(0,string)
                        set before [string range $expect_out(buffer) 0 [expr {$expect_out(0,start)-1}]]
                        reply OK $before $matched
                    }
                    full_buffer { reply OVERFLOW $expect_out(buffer) {} }
                    timeout {
                        set before {}
                        if {[info exists expect_out(buffer)]} { set before $expect_out(buffer) }
                        reply TIMEOUT $before {}
                    }
                    eof {
                        set before {}
                        if {[info exists expect_out(buffer)]} { set before $expect_out(buffer) }
                        reply EOF $before {}
                    }
                }
            }
            close { shutdown }
            default { error "invalid operation" }
        }
    }
    shutdown
}
if {[catch {bridge}]} {
    reply ERROR {} {}
    shutdown
}
