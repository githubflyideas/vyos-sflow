        }
       }
      }
     }
    }
   }
  },
  "/overview": {
   "get": {
    "summary": "Totals, the traffic chart and its peak for a period; with dir, the chart in or out through the busiest sampled interface.",
    "parameters": [
     {
      "name": "range",
      "in": "query",
      "required": false,
      "description": "Period ending now. Ignored when from and to are given.",
      "schema": {
       "type": "string",
       "enum": [
        "5m",
        "15m",
        "1h",
        "6h",
        "24h",
        "48h"
       ]
      }
     },
     {
      "name": "from",
      "in": "query",
      "required": false,
      "description": "Start, Unix milliseconds; with to, a period within the last 48 hours.",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "to",
      "in": "query",
      "required": false,
      "description": "End, Unix milliseconds.",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "f",
      "in": "query",
      "required": false,
      "description": "Filters, JSON: [{\"f\": field, \"v\": value, \"neg\": bool}], fields ip, src, dst, port, proto, app, exporter; at most 20.",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "dup",
      "in": "query",
      "required": false,
      "description": "1 counts traffic reported by several devices once per device.",
      "schema": {
       "type": "string",
       "enum": [
        "1"
       ]
      }
     },
     {
      "name": "tz",
      "in": "query",
      "required": false,
      "description": "The viewer's offset from UTC in minutes; days and hours are cut on that clock.",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "dir",
      "in": "query",
      "required": false,
      "description": "in or out.",
      "schema": {
       "type": "string",
       "enum": [
        "in",
        "out"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "The overview.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "default": {
      "description": "An error.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/topn": {
