       "type": "string"
      }
     },
     {
      "name": "dup",
      "in": "query",
      "required": false,
      "description": "1 counts traffic reported by several devices once per device.",
      "schema": {
       "type": "string",
       "enum": [
        "1"
       ]
      }
     },
     {
      "name": "tz",
      "in": "query",
      "required": false,
      "description": "The viewer's offset from UTC in minutes; days and hours are cut on that clock.",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "dim",
      "in": "query",
      "required": false,
      "description": "What to rank.",
      "schema": {
       "type": "string",
       "enum": [
        "host",
        "client",
        "server",
        "app",
        "proto"
       ]
      }
     },
     {
      "name": "by",
      "in": "query",
      "required": false,
      "description": "Ranked by.",
      "schema": {
       "type": "string",
       "enum": [
        "wire",
        "bytes",
        "pkts",
        "flows"
       ]
      }
     },
     {
      "name": "limit",
      "in": "query",
      "required": false,
      "description": "At most 1000, default 66.",
      "schema": {
       "type": "integer"
      }
     },
     {
      "name": "asc",
      "in": "query",
      "required": false,
      "description": "1 for the smallest first.",
      "schema": {
       "type": "string",
       "enum": [
        "1"
       ]
      }
     }
    ],
    "responses": {
     "200": {
      "description": "The ranking.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "default": {
      "description": "An error.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
