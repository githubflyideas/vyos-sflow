{
 "openapi": "3.1.0",
 "info": {
  "title": "vyos-sflow API",
  "version": "internal",
  "description": "Internal: the routes the web page and the terminal view use. It is not a supported public interface and may change in any release; it is kept here so a test can hold it equal to the route table. Request and response fields are snake_case. Errors are {\"error\": code, \"message\": text}: the code is stable and listed below, the text is for people. A wrong method is answered 405 with an Allow header."
 },
 "servers": [
  {
   "url": "/api"
  }
 ],
 "security": [
  {
   "session": []
  },
  {
   "basic": []
  },
  {
   "local": []
  }
 ],
 "paths": {
  "/login": {
   "post": {
    "summary": "Sign in; sets the session cookie.",
    "security": [],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "required": [
         "user",
         "password"
        ],
        "properties": {
         "user": {
          "type": "string"
         },
         "password": {
          "type": "string"
         }
        }
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Signed in.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "default": {
      "description": "An error.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/logout": {
   "post": {
    "summary": "End this session.",
    "responses": {
     "200": {
      "description": "Signed out.",
      "content": {
